# =============================================================================
# AI 路由配置（LiteLLM）
# =============================================================================
# 主聊天 provider fallback 顺序，按从左到右依次尝试。
# 可选值：openai, openrouter, fogmoe, siliconflow, gemini, zhipu, zai, azure
# 每个选中的 provider 都必须配置有效 API Key 和聊天模型；未使用的 provider 请从此列表移除。
AI_CHAT_ORDER=gemini,zhipu,siliconflow

# 命中这些逗号分隔的 shell-style 模式时，聊天模型不会直接接收图片输入。
# 这类模型会改用已由 vision 任务生成图片描述的纯文本聊天历史。
AI_CHAT_TEXT_ONLY_MODELS=deepseek-ai/DeepSeek-V4-Flash

# 各类后台任务使用的 provider。
# fallback provider 可选；不需要时保持注释即可。
# 每个选中的任务 provider 都必须有对应的 API Key 和任务模型配置。
# 如果只使用一套 AI 服务，请把所有任务 provider 改为同一服务，并补齐对应模型变量。
AI_RECAP_PROVIDER=gemini
# AI_RECAP_FALLBACK_PROVIDER=azure

AI_SUMMARY_PROVIDER=gemini
# AI_SUMMARY_FALLBACK_PROVIDER=azure

AI_TRANSLATE_PROVIDER=zhipu
# AI_TRANSLATE_FALLBACK_PROVIDER=openai

AI_VISION_PROVIDER=zhipu
# AI_VISION_FALLBACK_PROVIDER=openai

AI_CLASSIFIER_PROVIDER=zhipu
# AI_CLASSIFIER_FALLBACK_PROVIDER=openai

# 高级只读推理顾问。不使用时留空；启用时必须同时配置对应 provider 的
# *_ADVISOR_MODEL。fallback provider 可选。
AI_ADVISOR_PROVIDER=
AI_ADVISOR_FALLBACK_PROVIDER=

# 聊天历史 token 阈值（可选）
# 计数结果会先乘以 1.15 guard ratio 再比较，因此 120000 约等于
# LiteLLM 原始计数 104k 时触发压缩，用于保留上下文余量。
# CHAT_TOKEN_WARN_LIMIT=114000
# CHAT_TOKEN_LIMIT=120000


# =============================================================================
# OpenAI 配置（LiteLLM provider: openai/<model>）
# =============================================================================
OPENAI_API_KEY=your_openai_api_key_here

# 可选：OpenAI-compatible endpoint；使用官方 OpenAI 时通常不需要设置。
# OPENAI_BASE_URL=https://api.openai.com/v1

OPENAI_CHAT_MODEL=gpt-4o
OPENAI_RECAP_MODEL=gpt-4o-mini
OPENAI_SUMMARY_MODEL=gpt-4o-mini
OPENAI_TRANSLATE_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
OPENAI_CLASSIFIER_MODEL=gpt-4o-mini
OPENAI_ADVISOR_MODEL=


# =============================================================================
# OpenRouter 配置（LiteLLM 原生 provider: openrouter/<OpenRouter 模型 ID>）
# =============================================================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# 模型值使用 OpenRouter 目录中的完整 ID。
OPENROUTER_CHAT_MODEL=openai/gpt-5.6-luna
OPENROUTER_RECAP_MODEL=openai/gpt-5.6-luna
OPENROUTER_SUMMARY_MODEL=openai/gpt-5.6-luna
OPENROUTER_TRANSLATE_MODEL=openai/gpt-5.6-luna
OPENROUTER_VISION_MODEL=openai/gpt-5.6-luna
OPENROUTER_CLASSIFIER_MODEL=openai/gpt-5.6-luna
OPENROUTER_ADVISOR_MODEL=


# =============================================================================
# FOGMOE AI 配置（OpenAI-compatible endpoint）
# =============================================================================
FOGMOE_API_KEY=your_fogmoe_api_key_here
FOGMOE_API_BASE=https://your-fogmoe-endpoint.example/v1

# 模型值会原样发送给 FOGMOE endpoint。
FOGMOE_CHAT_MODEL=your_model_id
FOGMOE_RECAP_MODEL=your_model_id
FOGMOE_SUMMARY_MODEL=your_model_id
FOGMOE_TRANSLATE_MODEL=your_model_id
FOGMOE_VISION_MODEL=your_model_id
FOGMOE_CLASSIFIER_MODEL=your_model_id
FOGMOE_ADVISOR_MODEL=


# =============================================================================
# SiliconFlow 配置（OpenAI-compatible endpoint）
# =============================================================================
# Chat Completions 完整接口：
# https://api.siliconflow.cn/v1/chat/completions
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1

SILICONFLOW_CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_RECAP_MODEL=deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_SUMMARY_MODEL=deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_TRANSLATE_MODEL=deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_VISION_MODEL=deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_CLASSIFIER_MODEL=deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_ADVISOR_MODEL=


# =============================================================================
# Google Gemini 配置（LiteLLM provider: gemini/<model>）
# =============================================================================
# API Key 获取地址：https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 默认留空，使用 Google AI Studio 原生 Gemini endpoint。
GEMINI_API_BASE=

# 仅当 GEMINI_API_BASE 指向 OpenAI-compatible Gemini 代理时设为 true。
GEMINI_OPENAI_COMPATIBLE=false

GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_CHAT_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_RECAP_MODEL=gemini-3-flash-preview
GEMINI_SUMMARY_MODEL=gemini-3-flash-preview
GEMINI_SUMMARY_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_ADVISOR_MODEL=


# =============================================================================
# Azure OpenAI 配置（LiteLLM provider: azure/<deployment>）
# =============================================================================
# 获取地址：https://portal.azure.com/
AZURE_OPENAI_API_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=your_azure_deployment_name

AZURE_OPENAI_CHAT_MODEL=your_azure_deployment_name
# AZURE_OPENAI_RECAP_MODEL=your_azure_deployment_name
# AZURE_OPENAI_SUMMARY_MODEL=your_azure_deployment_name
# AZURE_OPENAI_TRANSLATE_MODEL=your_azure_deployment_name
# AZURE_OPENAI_VISION_MODEL=your_azure_deployment_name
# AZURE_OPENAI_CLASSIFIER_MODEL=your_azure_deployment_name
AZURE_OPENAI_ADVISOR_MODEL=


# =============================================================================
# Z.ai / 智谱配置（LiteLLM provider: zai/<model>）
# =============================================================================
# API Key 获取地址：https://open.bigmodel.cn/
ZAI_API_KEY=your_zai_api_key_here
ZAI_API_BASE=https://open.bigmodel.cn/api/paas/v4

ZHIPU_CHAT_MODEL=glm-4.7-flash
# ZHIPU_RECAP_MODEL=glm-4.5-flash
ZHIPU_TRANSLATE_MODEL=glm-4.7-flash
ZHIPU_VISION_MODEL=glm-4.6v-flash
ZHIPU_CLASSIFIER_MODEL=glm-4.7-flash
# ZHIPU_SUMMARY_MODEL=glm-4.5-flash
ZHIPU_ADVISOR_MODEL=


# =============================================================================
# Telegram Bot 配置
# =============================================================================
# Token 获取地址：https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 必填：部署者自己的 Telegram 数字用户 ID。
# 它控制管理员命令，并接收人工充值申请；不要使用示例或他人的 ID。
ADMIN_USER_ID=


# =============================================================================
# MySQL 数据库配置
# =============================================================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=fogmoe_telegram_bot_db


# =============================================================================
# 运行时：准入、整轮截止时间与线程适配器（默认值适合单进程小中型部署）
# =============================================================================
# 取值依据与调参方法见 docs/runtime.md。以下均为默认值，需要时取消注释修改。

# 同时运行的 AI 对话轮次上限（全局）。超出的排队，见下面的队列长度与最长等待。
# CHAT_MAX_CONCURRENT_TURNS=32
# 等待槽位的队列最长多少个轮次；队列满时新请求立即收到「繁忙」提示（不扣硬币）。
# CHAT_MAX_QUEUED_TURNS=32
# 同一个用户同时「处理中 + 排队」的轮次上限。会话锁保证同一用户一次只运行一轮，
# 这个上限限制的是排在会话锁后面的深度。
# CHAT_MAX_PENDING_PER_USER=3
# 排队等槽位的最长秒数，超过后收到「繁忙」提示（不扣硬币）；0 表示不排队，满了就拒绝。
# CHAT_QUEUE_MAX_WAIT_SECONDS=20
# 整轮截止时间（秒），从进入队列开始计时，覆盖排队、provider 回退、工具与投递。
# 到期时取消剩余工作并提示用户；已经扣的硬币不退。
# 单次模型调用的超时是 AI_CHAT_COMPLETION_TIMEOUT_SECONDS，它会被收紧到剩余时间之内。
# CHAT_TURN_DEADLINE_SECONDS=360

# Telegram 同时处理的 update 数量（python-telegram-bot 的 concurrent_updates）。
# 应当大于 CHAT_MAX_CONCURRENT_TURNS + CHAT_MAX_QUEUED_TURNS，给命令与回调留出余量。
# TELEGRAM_CONCURRENT_UPDATES=128

# 同步工具（requests、e2b、binance 等同步 SDK）的线程池大小；其余工具与模型调用是原生 async。
# BLOCKING_TOOL_THREADS=8
# 事件循环回调里零星同步网络调用的线程池大小。
# BLOCKING_IO_THREADS=4

# 指标汇总日志的间隔（秒），0 关闭。每个间隔写一行 INFO，格式见 docs/runtime.md。
# RUNTIME_METRICS_LOG_INTERVAL_SECONDS=300
# 收到停止信号后给在途对话轮次的宽限（秒），之后取消并提示用户。
# 要小于进程管理器的停止超时（Docker Compose 的 stop_grace_period 已设为 30s），
# 否则宽限还没到就被强制终止。
# RUNTIME_SHUTDOWN_GRACE_SECONDS=8


# =============================================================================
# 日志配置
# =============================================================================
# 日志始终写入 logs/tgbot.log，轮转与保留策略见 README 的“日志”一节。
# LOG_LEVEL=INFO
# 同时输出到 stdout，供 docker logs 查看。
# LOG_TO_STDOUT=true


# =============================================================================
# 搜索 API 配置
# =============================================================================
# SerpApi Key 获取地址：https://serpapi.com/
SERPAPI_API_KEY=your_serpapi_key_here


# =============================================================================
# 代码执行 API 配置
# =============================================================================
# Judge0 API Key 获取地址：https://ce.judge0.com/
JUDGE0_API_KEY=your_judge0_api_key_here

# E2B API Key 获取地址：https://e2b.dev/
E2B_API_KEY=your_e2b_api_key_here


# =============================================================================
# 图片生成 API 配置
# =============================================================================
IMAGE_GEN_API_URL=
IMAGE_GEN_API_TOKEN=your_image_generation_api_token_here


# =============================================================================
# Fish Audio 语音生成配置
# =============================================================================
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_REFERENCE_ID=dc020cb237df4248907565718715b20b


# =============================================================================
# 群组 X 账号同步（/xfeed）
# =============================================================================
# 数据源：FxTwitter API v2，不需要登录或 API key；可换成自建的 FxEmbed
X_FEED_API_BASE=https://api.fxtwitter.com
